#!/bin/sh
# ==============================================================================
# GameGhost Universal CLI Launcher (Compatible with Linux & Android Termux)
# Completely independent from external projects.
# ==============================================================================
set -e

SOURCE="$0"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE%/*}" = "$SOURCE" ] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_DIR="$( cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd )"

# Termux environment support
if [ -d "/data/data/com.termux/files/usr/bin" ]; then
    export PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
    export PATH="/data/data/com.termux/files/usr/bin:${HOME}/bin:${PATH}"
    export TMPDIR="${PREFIX}/tmp"
    mkdir -p "${TMPDIR}" 2>/dev/null || true
fi
export PATH="${HOME}/.local/bin:${PATH}"

# Ensure DISPLAY & XAUTHORITY
if [ -z "$DISPLAY" ]; then
    for num in 0 1 2; do
        if [ -S "/tmp/.X11-unix/X${num}" ] || [ -S "${PREFIX}/tmp/.X11-unix/X${num}" ] || [ -S "/data/data/com.termux/files/usr/tmp/.X11-unix/X${num}" ]; then
            export DISPLAY=":${num}"
            break
        fi
    done
    if [ -z "$DISPLAY" ] && [ -d "/data/data/com.termux/files" ]; then
        export DISPLAY=":0"
    fi
fi

if [ -z "$XAUTHORITY" ]; then
    UID_NUM="$(id -u 2>/dev/null || echo 1000)"
    if ls /run/user/${UID_NUM}/.mutter-Xwaylandauth* >/dev/null 2>&1; then
        export XAUTHORITY="$(ls -1 /run/user/${UID_NUM}/.mutter-Xwaylandauth* 2>/dev/null | head -n 1)"
    elif [ -f "${HOME}/.Xauthority" ]; then
        export XAUTHORITY="${HOME}/.Xauthority"
    fi
fi

export PYGAME_HIDE_SUPPORT_PROMPT="1"
export PYTHONPATH="${PROJECT_DIR}:${PYTHONPATH}"

# In Termux/Android, use system python3 directly with software fallback if needed
if [ -n "$TERMUX_VERSION" ] || [ -d "/data/data/com.termux/files" ]; then
    export SDL_VIDEODRIVER="x11"
    export LIBGL_ALWAYS_SOFTWARE="1"
    export GALLIUM_DRIVER="llvmpipe"
    export MESA_LOADER_DRIVER_OVERRIDE="llvmpipe"
    export SDL_RENDER_DRIVER="software"
    export SDL_VIDEO_X11_NODIRECTCOLOR="1"
    export SDL_VIDEO_X11_NET_WM_BYPASS_COMPOSITOR="0"
    export MESA_DEBUG="silent"
    export EGL_LOG_LEVEL="fatal"

    # Bring Termux-X11 companion app to foreground if launching client/game
    if [ "$1" = "client" ] || [ "$1" = "dmc5" ] || [ "$1" = "sekiro" ] || [ "$1" = "tekken8" ] || [ "$1" = "mk11" ] || [ "$1" = "mgr" ] || [ "$1" = "rottr" ] || [ -z "$1" ]; then
        if command -v am >/dev/null 2>&1; then
            am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1 || \
            am start -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1 || true
        fi
    fi

    exec python3 -m gameghost.cli "$@"
fi

# Self-contained project virtual environment (independent of CPUGhost)
VENV_DIR="${PROJECT_DIR}/.venv"

if [ -f "${VENV_DIR}/bin/python" ]; then
    VENV_PYTHON="${VENV_DIR}/bin/python"
else
    echo "[INFO] Initializing dedicated GameGhost Python environment..."
    DEPS="fastapi uvicorn websockets mss pillow pynput requests rich click evdev"
    if command -v uv >/dev/null 2>&1; then
        uv venv "${VENV_DIR}"
        uv pip install --python "${VENV_DIR}/bin/python" $DEPS
        VENV_PYTHON="${VENV_DIR}/bin/python"
    else
        python3 -m venv "${VENV_DIR}"
        "${VENV_DIR}/bin/pip" install --upgrade pip
        "${VENV_DIR}/bin/pip" install $DEPS
        VENV_PYTHON="${VENV_DIR}/bin/python"
    fi
    echo "[OK] Dedicated GameGhost environment initialized."
fi

exec "$VENV_PYTHON" -m gameghost.cli "$@"
